{
  "name": "hn-ai-sitter",
  "description": "Daily sitter that checks the HN front page and summarizes AI posts.",
  "model": "openai-codex/gpt-5.4-mini",
  "trigger": {
    "type": "cron",
    "schedule": "17 8 * * *"
  },
  "guardrails": {
    "allowed_side_effects": [
      "write-file:inbox/"
    ],
    "llm_optional": true,
    "max_actions": 1,
    "stop_file": "hn-ai-sitter.stop",
    "receipt": {
      "path": "receipts/last.json"
    }
  }
}
