{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/dallascrilley/agent-forge/schema/orchestrator/review-packet.schema.json",
  "title": "ReviewPacket",
  "description": "Agent Forge companion orchestration contract v1; separate from Agent Spec v1.",
  "type": "object",
  "required": [
    "schemaVersion",
    "workerId",
    "originalTask",
    "acceptanceCriteria",
    "constraints",
    "workerManifestSummary",
    "baseRevision",
    "headRevision",
    "diffArtifact",
    "claims",
    "verificationCommands",
    "verificationOutputs",
    "artifacts"
  ],
  "additionalProperties": false,
  "properties": {
    "schemaVersion": {
      "type": "integer",
      "const": 1
    },
    "workerId": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]*$"
    },
    "originalTask": {
      "type": "string",
      "minLength": 1
    },
    "acceptanceCriteria": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      },
      "minItems": 1
    },
    "constraints": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "workerManifestSummary": {
      "type": "object",
      "required": [
        "manifestId",
        "permissionProfile",
        "resourceIds"
      ],
      "additionalProperties": false,
      "properties": {
        "manifestId": {
          "type": "string",
          "pattern": "^sha256:[0-9a-f]{64}$"
        },
        "permissionProfile": {
          "const": "modify-isolated"
        },
        "resourceIds": {
          "type": "array",
          "items": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9.-]*$"
          },
          "uniqueItems": true
        }
      }
    },
    "baseRevision": {
      "type": "string",
      "pattern": "^[0-9a-fA-F]{7,64}$"
    },
    "headRevision": {
      "type": "string",
      "pattern": "^[0-9a-fA-F]{7,64}$"
    },
    "diffArtifact": {
      "type": "object",
      "required": [
        "path",
        "sha256"
      ],
      "additionalProperties": false,
      "properties": {
        "path": {
          "type": "string",
          "pattern": "^(?!/)(?!.*(?:^|/)\\.\\.(?:/|$)).+$"
        },
        "sha256": {
          "type": "string",
          "pattern": "^sha256:[0-9a-f]{64}$"
        }
      }
    },
    "claims": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "id",
          "statement",
          "evidenceIds"
        ],
        "additionalProperties": false,
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9.-]*$"
          },
          "statement": {
            "type": "string",
            "minLength": 1
          },
          "evidenceIds": {
            "type": "array",
            "items": {
              "type": "string",
              "pattern": "^[a-z][a-z0-9.-]*$"
            },
            "uniqueItems": true
          }
        }
      }
    },
    "verificationCommands": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "id",
          "argv"
        ],
        "additionalProperties": false,
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9.-]*$"
          },
          "argv": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            },
            "minItems": 1
          }
        }
      }
    },
    "verificationOutputs": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "commandId",
          "status",
          "artifactId"
        ],
        "additionalProperties": false,
        "properties": {
          "commandId": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9.-]*$"
          },
          "status": {
            "type": "string",
            "enum": [
              "passed",
              "failed",
              "not-run"
            ]
          },
          "artifactId": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9.-]*$"
          }
        }
      }
    },
    "artifacts": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "id",
          "path",
          "sha256"
        ],
        "additionalProperties": false,
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9.-]*$"
          },
          "path": {
            "type": "string",
            "pattern": "^(?!/)(?!.*(?:^|/)\\.\\.(?:/|$)).+$"
          },
          "sha256": {
            "type": "string",
            "pattern": "^sha256:[0-9a-f]{64}$"
          }
        }
      }
    }
  }
}
